# IRDSS Interoperability Layer host used by the local Mock Hospital backend.
IOL_HOST=127.0.0.1

# Generate independent 32-byte keys and base64-encode them. Never reuse the
# RSA request-signing key and never commit real key values.
# PowerShell example:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
LOCAL_DATA_ENCRYPTION_KEY=
LOCAL_DATA_INDEX_KEY=

